# --- Public application metadata (exposed to the browser) ---
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app

# Optional: override the primary Arc Testnet RPC endpoint. When empty, the app
# falls back to viem's built-in Arc Testnet RPC list. Public RPCs are shared and
# may be rate-limited; set a private endpoint for production stability.
NEXT_PUBLIC_ARC_PRIMARY_RPC_URL=https://rpc.testnet.arc.network

# WalletConnect Cloud project id (https://cloud.walletconnect.com).
# Optional: when empty only injected/browser wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Circle App Kit key from the Circle Console (https://console.circle.com).
# Optional for swaps, recommended for production monetization/fees.
NEXT_PUBLIC_CIRCLE_KIT_KEY=
